{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Let's Eat Grandma",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\server"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Let's eat grandma AI running on http://localhost:",
          "endsPattern": "Let's eat grandma AI running on http://localhost:"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
